# Server
PORT=5000
CLIENT_URL=http://localhost:5173

# Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Database (SQLite file - zero setup). Swap to Postgres in production by
# changing src/config/db.js dialect + DATABASE_URL.
DATABASE_STORAGE=./data/database.sqlite

# Seat hold
SEAT_HOLD_TTL_MINUTES=10
WAITLIST_OFFER_TTL_MINUTES=15
HOLD_EXPIRY_CRON="*/30 * * * * *"

# Email (use https://ethereal.email for a free fake SMTP inbox during dev,
# or Gmail with an App Password for real delivery)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your_ethereal_or_gmail_user
SMTP_PASS=your_ethereal_or_gmail_app_password
SMTP_FROM="Ticket Booking <no-reply@ticketbooking.com>"
